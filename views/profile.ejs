<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Profile</title>
</head>
<body class="bg-black text-white transition duration-300" id="theme">
    <div class="max-w-4xl mx-auto p-4">
        <div class="flex justify-between items-center">
            <h1 class="text-2xl font-bold">Hello <%= user.name %> 👋</h1>
            <button id="toggleTheme" class="px-4 py-2 bg-gray-700 text-white rounded hover:bg-gray-600">Switch Mode</button>
        </div>

        <!-- Profile Picture Section -->
        <div class="mt-4 flex items-center space-x-4">
            <% if (user.profilepic) { %>
                <img src="/images/uploads/<%= user.profilepic %>" alt="Profile Picture" class="w-24 h-24 rounded-full border-4 border-gray-500">
            <% } else { %>
                <img src="https://via.placeholder.com/100" alt="Default Profile" class="w-24 h-24 rounded-full border-4 border-gray-500">
            <% } %>
            <div>
                <form action="updateDP" method="post" enctype="multipart/form-data">
                    <label for="dp" class="block text-sm font-semibold">Update Profile Picture</label>
                    <input type="file" name="dp" class="mt-1 text-sm">
                    <button type="submit" class="px-3 py-1 bg-blue-500 text-white rounded mt-2">Update DP</button>
                </form>
            </div>
        </div>

        <h4 class="mt-6 text-lg font-semibold">Create New Post</h4>
        <form action="/post" method="post" class="mt-2">
            <input type="text" name="postDesc" placeholder="What's on your mind" 
                class="w-full p-2 bg-gray-800 rounded text-white outline-none" required>
            <input type="text" name="image" placeholder="Image URL" 
                class="w-full p-2 bg-gray-800 rounded text-white outline-none mt-2">
            <button type="submit" class="mt-3 bg-blue-500 px-4 py-2 rounded hover:bg-blue-600">Create Post</button>
        </form>

        <a href="/homepage" class="block mt-2 text-blue-400">Back to Homepage</a>
        <a href="/logout" class="block mt-4 text-red-400">Logout</a>

        <!-- Posts Section -->
        <div class="mt-6">
            <h4 class="text-xl font-semibold">Your Posts</h4>
            <div class="grid grid-cols-3 gap-4 mt-4">
                <% user.posts.reverse().forEach(function(post){ %>
                    <div class="bg-gray-900 p-4 rounded-lg">
                        <h5 class="text-sm text-gray-400">@<%= user.username %></h5>
                        <% if (post.postImage) { %>
                            <div class="relative cursor-pointer" onclick="toggleZoom(this)">
                                <img src="<%= post.postImage %>" alt="Post Image" class="w-full h-48 object-cover rounded transition-transform duration-300">
                            </div>
                        <% } %>
                        <p class="mt-2"><%= post.postDesc %></p>
                        <div class="flex items-center justify-between mt-3">
                            <p class="text-gray-400"><%= post.Likes.length %> likes</p>
                            <div class="space-x-4">
                                <a href="/like/<%= post._id %>" class="text-blue-400 hover:underline">
                                    <%= post.Likes.indexOf(user._id) === -1 ? "Like" : "Unlike" %>
                                </a>
                                <a href="/edit/<%= post._id %>" class="text-yellow-400 hover:underline">Edit</a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>

    <script>
        const themeToggle = document.getElementById("toggleTheme");
        const body = document.getElementById("theme");
        themeToggle.addEventListener("click", () => {
            if (body.classList.contains("bg-black")) {
                body.classList.replace("bg-black", "bg-white");
                body.classList.replace("text-white", "text-black");
            } else {
                body.classList.replace("bg-white", "bg-black");
                body.classList.replace("text-black", "text-white");
            }
        });

        function toggleZoom(element) {
            const img = element.querySelector("img");
            if (img.classList.contains("h-48")) {
                img.classList.replace("h-48", "h-96");
            } else {
                img.classList.replace("h-96", "h-48");
            }
        }
    </script>
</body>
</html>
